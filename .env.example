APP_ENV=development
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/umkm_food_quality
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
MODEL_PATH=ml/model/umkm_food_quality_v1/model.keras
CLASS_INDICES_PATH=ml/model/umkm_food_quality_v1/class_indices.json
MODEL_REGISTRY_PATH=ml/model
ACTIVE_MODEL_CONFIG_PATH=ml/model/active_model.json
MODEL_QUALITY_REPORT_PATH=ml/model/model_quality_report.json
MODEL_QUALITY_STRICT=false
ENABLE_MULTI_MODEL_COMPARISON=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated allowed image hostnames for /detect.
# Leave empty to allow any public host (private/loopback IPs always rejected).
ALLOWED_IMAGE_DOMAINS=res.cloudinary.com

IMAGE_DOWNLOAD_MAX_BYTES=10485760
IMAGE_DOWNLOAD_MAX_REDIRECTS=3
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=20
EMAIL_BACKEND=console
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@foodqcheck.local
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
RESET_PASSWORD_FRONTEND_URL=foodqcheck://reset-password
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
VERIFY_EMAIL_FRONTEND_URL=foodqcheck://verify-email
REQUIRE_VERIFIED_EMAIL=true

# Set to false to skip TF model warmup at startup (useful for fast dev iteration).
WARMUP_PREDICTOR_ON_STARTUP=true
