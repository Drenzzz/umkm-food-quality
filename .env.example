# =============================================================================
# UMKM Food Quality API — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in real values.
# Never commit the populated .env file — it is already in .gitignore.
#
# Generate a secure SECRET_KEY:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- Runtime ----------------------------------------------------------------
APP_ENV=development
# development: SQLite auto-create, debug docs, verbose errors
# production:  PostgreSQL, no docs endpoint, minimal error detail
# test:        SQLite in-memory, rate limiting disabled

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://foodqcheck:REPLACE_WITH_DB_PASSWORD@localhost:5432/umkm_food_quality

# --- Security ---------------------------------------------------------------
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Model ------------------------------------------------------------------
MODEL_PATH=ml/model/umkm_food_quality_v1/model.keras
CLASS_INDICES_PATH=ml/model/umkm_food_quality_v1/class_indices.json
MODEL_REGISTRY_PATH=ml/model
ACTIVE_MODEL_CONFIG_PATH=ml/model/active_model.json
MODEL_QUALITY_REPORT_PATH=ml/model/model_quality_report.json
MODEL_QUALITY_STRICT=false
ENABLE_MULTI_MODEL_COMPARISON=false

# --- CORS & hosts -----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Image download guard ---------------------------------------------------
# Comma-separated allowed image hostnames for /detect.
# Leave empty to allow any public host (private/loopback IPs always rejected).
ALLOWED_IMAGE_DOMAINS=res.cloudinary.com
IMAGE_DOWNLOAD_MAX_BYTES=10485760
IMAGE_DOWNLOAD_MAX_REDIRECTS=3
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=20

# --- Runtime ----------------------------------------------------------------
WARMUP_PREDICTOR_ON_STARTUP=true
