# Docker-specific environment template.
# Copy to deploy/env.production and fill in real values.
# Paths here are INSIDE the Docker container (handled by volume mounts).

APP_ENV=production

# --- Database ----------------------------------------------------------------
# Uses Docker service name "db" — not localhost.
DB_USER=foodqcheck
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
DB_NAME=umkm_food_quality
DATABASE_URL=postgresql+psycopg://foodqcheck:REPLACE_WITH_DB_PASSWORD@db:5432/umkm_food_quality

# --- Security ---------------------------------------------------------------
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Model ------------------------------------------------------------------
# These paths are inside the container. Model files are bind-mounted from
# the host via docker-compose volumes: ../ml/model → /app/ml/model
MODEL_PATH=/app/ml/model/umkm_food_quality_v1/model.keras
CLASS_INDICES_PATH=/app/ml/model/umkm_food_quality_v1/class_indices.json
MODEL_REGISTRY_PATH=/app/ml/model
ACTIVE_MODEL_CONFIG_PATH=/app/ml/model/active_model.json
MODEL_QUALITY_REPORT_PATH=/app/ml/model/model_quality_report.json
MODEL_QUALITY_STRICT=true
ENABLE_MULTI_MODEL_COMPARISON=false

# --- CORS & hosts -----------------------------------------------------------
CORS_ORIGINS=https://foodqcheck.drenzzz.dev
ALLOWED_HOSTS=foodqcheck.drenzzz.dev,localhost,127.0.0.1

# --- Image download guard ---------------------------------------------------
ALLOWED_IMAGE_DOMAINS=res.cloudinary.com
IMAGE_DOWNLOAD_MAX_BYTES=10485760
IMAGE_DOWNLOAD_MAX_REDIRECTS=3
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=20

# --- Email ------------------------------------------------------------------
# console: log emails to stdout (development)
# resend:  send via Resend HTTPS API (recommended — works on port 443)
# smtp:    send via SMTP server
EMAIL_BACKEND=console
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@foodqcheck.local

# --- Runtime ----------------------------------------------------------------
WARMUP_PREDICTOR_ON_STARTUP=true
