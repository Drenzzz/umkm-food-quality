# Production environment template.
# Copy to /opt/foodqcheck/.env on the VPS and fill in real values.
# Never commit the populated .env file.

APP_ENV=production

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://foodqcheck:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/umkm_food_quality

# --- Security ---------------------------------------------------------------
# Generate a fresh 64-char random key, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Model ------------------------------------------------------------------
MODEL_PATH=/opt/foodqcheck/ml/model/umkm_food_quality_v1/model.keras
CLASS_INDICES_PATH=/opt/foodqcheck/ml/model/umkm_food_quality_v1/class_indices.json
MODEL_REGISTRY_PATH=/opt/foodqcheck/ml/model
ACTIVE_MODEL_CONFIG_PATH=/opt/foodqcheck/ml/model/active_model.json
MODEL_QUALITY_REPORT_PATH=/opt/foodqcheck/ml/model/model_quality_report.json
MODEL_QUALITY_STRICT=true
ENABLE_MULTI_MODEL_COMPARISON=false

# --- CORS & hosts -----------------------------------------------------------
CORS_ORIGINS=https://foodqcheck.drenzzz.dev
ALLOWED_HOSTS=foodqcheck.drenzzz.dev,localhost,127.0.0.1

# --- Image download guard ---------------------------------------------------
ALLOWED_IMAGE_DOMAINS=res.cloudinary.com
IMAGE_DOWNLOAD_MAX_BYTES=10485760
IMAGE_DOWNLOAD_MAX_REDIRECTS=3
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=20

# --- Email (Resend or SMTP / Gmail) ----------------------------------------
# Recommended: "resend" — works on HTTPS port 443 which most VPS providers
# (DigitalOcean, Vultr, Linode, etc.) leave open even when they block
# outbound SMTP. Free tier covers 100 emails/day.
EMAIL_BACKEND=resend
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Sender address must be a verified domain at https://resend.com/domains
# (or use the test sender "onboarding@resend.dev" limited to your own email)
EMAIL_FROM=onboarding@resend.dev
# SMTP fallback (Gmail needs App Password, see https://myaccount.google.com/apppasswords)
# Only used when EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
RESET_PASSWORD_FRONTEND_URL=https://foodqcheck.drenzzz.dev/reset-password
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
VERIFY_EMAIL_FRONTEND_URL=https://foodqcheck.drenzzz.dev/verify-email
REQUIRE_VERIFIED_EMAIL=true

# --- Runtime ----------------------------------------------------------------
WARMUP_PREDICTOR_ON_STARTUP=true
